                      "direccion_completa": "AV. NICOLÁS DE PIÉROLA 789., LIMA - LIMA - CERCADO DE LIMA",
                      "departamento": "LIMA",
                      "provincia": "LIMA",
                      "distrito": "CERCADO DE LIMA",
                      "ubigeo_sunat": "150101",
                      "ubigeo": [
                        "15",
                        "1501",
                        "150101"
                      ]
                    },
                    {
                      "codigo": "0002",
                      "tipo_establecimiento": "SU. SUCURSAL",
                      "actividad_economica": "-",
                      "direccion": "AV. ALFONSO UGARTE 848.",
                      "direccion_completa": "AV. ALFONSO UGARTE 848., LIMA - LIMA - CERCADO DE LIMA",
                      "departamento": "LIMA",
                      "provincia": "LIMA",
                      "distrito": "LIMA",
                      "ubigeo_sunat": "150101",
                      "ubigeo": [
                        "15",
                        "1501",
                        "150101"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No se encontró información para el RUC enviado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseRucEstablecimientos"
                },
                "example": {
