{
  "openapi": "3.1.0",
  "info": {
    "title": "API JSON",
    "description": "Documentación de la API JSON",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.json.com.pe"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/dni": {
      "post": {
        "summary": "Consultar información de un DNI",
        "description": "Consulta la información asociada a un DNI",
        "requestBody": {
          "description": "Datos necesarios para realizar la consulta.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaDniRequest"
              },
              "example": {
                "dni": "12345678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consulta realizada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaDniResponse"
                },
                "example": {
                  "success": true,
                  "message": "Exito",
                  "data": {
                    "numero": "12345678",
                    "nombre_completo": "PEREZ GOMEZ, JUAN JOSE",
                    "nombres": "JUAN JOSE",
                    "apellido_paterno": "PEREZ",
                    "apellido_materno": "GOMEZ",
                    "codigo_verificacion": 9,
                    "direccion": "",
                    "direccion_completa": "",
                    "ubigeo_reniec": "",
                    "ubigeo_sunat": "",
                    "ubigeo": [
                      null,
                      null,
                      null
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "No se encontró información para el DNI enviado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDNI"
                },
                "example": {
                  "success": false,
                  "message": "No se encontró DNI"
                }
              }
            }
          }
        }
      }
    },
    "/ruc": {
      "post": {
        "summary": "Consultar información de un RUC",
        "description": "Consulta la información asociada a un RUC",
        "requestBody": {
          "description": "Datos necesarios para realizar la consulta.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRucRequest"
              },
              "example": {
                "ruc": "20123456789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consulta realizada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaRucResponse"
                },
                "example": {
                  "success": true,
                  "message": "exito",
                  "data": {
                    "ruc": "20123456789",
                    "nombre_o_razon_social": "HAMID S.A.C.",
                    "estado": "SUSPENSION TEMPORAL",
                    "condicion": "HABIDO",
                    "departamento": "LIMA",
                    "provincia": "LIMA",
                    "distrito": "CERCADO DE LIMA",
                    "direccion": "AV. NICOLÁS DE PIÉROLA 789.",
                    "direccion_completa": "AV. NICOLÁS DE PIÉROLA 789., LIMA - LIMA - CERCADO DE LIMA",
                    "ubigeo_sunat": "150137",
                    "ubigeo": [
                      "15",
                      "1501",
                      "150101"
                    ],
                    "es_agente_de_retencion": "NO",
                    "es_agente_de_percepcion": "NO",
                    "es_agente_de_percepcion_combustible": "NO",
                    "es_buen_contribuyente": "SI"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No se encontró información para el RUC enviado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseRuc"
                },
                "example": {
                  "success": false,
                  "message": "No se encontró RUC"
                }
              }
            }
          }
        }
      }
    },
    "/ruc/representantes": {
      "post": {
        "summary": "Consultar representante de un RUC",
        "description": "Consulta representante legal por RUC",
        "requestBody": {
          "description": "Datos necesarios para realizar la consulta.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRucRepresentanteRequest"
              },
              "example": {
                "ruc": "20123456789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consulta realizada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaRucRepresentanteResponse"
                },
                "example": {
                  "success": true,
                  "message": "exito",
                  "data": [
                    {
                      "tipo_de_documento": "DNI",
                      "numero_de_documento": "7*****54",
                      "nombre": "JUAN *****O ***NA",
                      "cargo": "GERENTE GENERAL",
                      "fecha_desde": "05/05/2012"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No se encontró información para el RUC enviado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseRucRepresentante"
                },
                "example": {
                  "success": false,
                  "message": "No se encontró RUC"
                }
              }
            }
          }
        }
      }
    },
    "/ruc/establecimientos": {
      "post": {
        "summary": "Consultar establecimientos de un RUC",
        "description": "Consulta establecimientos por RUC",
        "requestBody": {
          "description": "Datos necesarios para realizar la consulta.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRucEstablecimientosRequest"
              },
              "example": {
                "ruc": "20123456789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consulta realizada correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaRucEstablecimientosResponse"
                },
                "example": {
                  "success": true,
                  "message": "exito",
                  "data": [
                    {
                      "codigo": "0001",
                      "tipo_establecimiento": "SU. SUCURSAL",
                      "actividad_economica": "-",
